---
const { node } = Astro.props;

const url = node?.url;
const buttonText = node?.buttonText || 'Скачать файл';
const filename = node?.filename || '';
const size = node?.size;
const extension = node?.extension;

function formatFileSize(bytes) {
    if (!bytes) return '';
    if (bytes < 1024) return `${bytes} Б`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} КБ`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} МБ`;
}
---

{url && (
    <a 
        href={url} 
        class="inline-attachment" 
        download={filename}
        target="_blank"
        rel="noopener"
    >
        <div class="inline-attachment-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <div class="inline-attachment-info">
            <div class="inline-attachment-label">{buttonText}</div>
            {filename && (
                <div class="inline-attachment-meta">
                    {filename}
                    {size && ` · ${formatFileSize(size)}`}
                    {extension && ` · ${extension.toUpperCase()}`}
                </div>
            )}
        </div>

        <div class="inline-attachment-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
    </a>
)}

<style>
    .inline-attachment {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 1.8em 0;
        padding: 16px 20px;
        background: var(--accent-primary);
        border-radius: 14px;
        text-decoration: none !important;
        color: #fff !important;
        position: relative;
        z-index: 1;
        border-bottom: none !important;
        transition: 
            transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            filter 0.4s ease;
    }

    .inline-attachment:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(128, 37, 37, 0.25);
        filter: brightness(1.05);
        background-color: var(--accent-primary) !important;
    }

    .inline-attachment-icon {
        flex-shrink: 0;
        width: 26px;
        height: 26px;
        color: rgba(255, 255, 255, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .inline-attachment-icon svg {
        width: 100%;
        height: 100%;
    }

    .inline-attachment-info {
        flex: 1;
        min-width: 0;
    }

    .inline-attachment-label {
        font-family: var(--font-body);
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        line-height: 1.3;
    }

    .inline-attachment-meta {
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.78);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 400;
        margin-top: 3px;
    }

    .inline-attachment-arrow {
        flex-shrink: 0;
        width: 28px;
        height: 28px;
        color: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .inline-attachment-arrow svg {
        width: 16px;
        height: 16px;
    }

    .inline-attachment:hover .inline-attachment-arrow {
        transform: translateY(2px);
    }

    @media (max-width: 768px) {
        .inline-attachment {
            gap: 12px;
            padding: 14px 16px;
        }
        .inline-attachment-label {
            font-size: 0.95rem;
        }
        .inline-attachment-meta {
            font-size: 0.78rem;
        }
    }
</style>