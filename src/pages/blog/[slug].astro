---
export const prerender = true;

import { sanityClient, urlFor } from '../../lib/sanity';
import MainLayout from '../../layouts/MainLayout.astro';
import { PortableText } from 'astro-portabletext';
import PortableTextImage from '../../components/PortableTextImage.astro';
import GlossaryTooltip from '../../components/GlossaryTooltip.astro';
import PortableTextFile from '../../components/PortableTextFile.astro';

const customComponents = {
  type: {
    image: PortableTextImage,
    fileAttachment: PortableTextFile,
  },
  mark: {
    glossaryTooltip: GlossaryTooltip,
  }
};

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug.current) && !(_id in path("drafts.**"))]{ slug }`);
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;

const post = await sanityClient.fetch(`*[_type == "post" && slug.current == $slug][0]{
  title,
  publishedAt,
  mainImage,
  body[]{
    ...,
    _type == "fileAttachment" => {
        ...,
        "url": file.asset->url,
        "filename": file.asset->originalFilename,
        "size": file.asset->size,
        "extension": file.asset->extension
    },
    markDefs[]{
        ...,
        _type == "glossaryTooltip" => {
        ...,
        "term": reference->term,
        "definition": reference->definition
        }
    }
    },
  "authorName": author->name,
  "authorImage": author->image,
  "categoryTitle": category->title,
  "attachment": {
    "label": attachment.label,
    "url": attachment.asset->url,
    "filename": attachment.asset->originalFilename,
    "size": attachment.asset->size,
    "extension": attachment.asset->extension
  }
}`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

// Хелпер: красиво форматируем размер файла
function formatFileSize(bytes) {
    if (!bytes) return '';
    if (bytes < 1024) return `${bytes} Б`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} КБ`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} МБ`;
}

const hasAttachment = post.attachment && post.attachment.url;
---

<MainLayout title={post.title}>
    <article class="article-container">
        
        <header class="article-header">
            {post.categoryTitle && (
                <div class="category-tag">{post.categoryTitle}</div>
            )}
            <h1 class="article-main-title">{post.title}</h1>
            
            <div class="article-meta">
                <div class="meta-author">
                    {post.authorImage ? (
                        <img src={urlFor(post.authorImage).width(96).height(96).auto('format').url()} alt={post.authorName} class="author-avatar" />
                    ) : (
                        <div class="author-avatar-placeholder">👤</div>
                    )}
                    <span>{post.authorName || 'Редакция'}</span>
                </div>
                <span class="meta-dot">•</span>
                <time class="meta-date">
                    {new Date(post.publishedAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
            </div>
        </header>

        {post.mainImage && (
            <div class="article-hero-image">
                <img 
                    src={urlFor(post.mainImage).width(1200).auto('format').url()} 
                    alt={post.title}
                    loading="eager" 
                />
            </div>
        )}

        <div class="editorial-content">
            {post.body ? (
                <PortableText value={post.body} components={customComponents} />
            ) : (
                <p>Текст статьи скоро появится...</p>
            )}
        </div>

        {hasAttachment && (
            <a 
                href={post.attachment.url} 
                class="attachment-card" 
                download={post.attachment.filename}
                target="_blank"
                rel="noopener"
            >
                <div class="attachment-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                        <path d="M14 2v6h6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    </svg>
                    {post.attachment.extension && (
                        <span class="attachment-ext">{post.attachment.extension.toUpperCase()}</span>
                    )}
                </div>
                <div class="attachment-info">
                    <div class="attachment-label">
                        {post.attachment.label || 'Скачать материалы'}
                    </div>
                    <div class="attachment-meta">
                        {post.attachment.filename}
                        {post.attachment.size && ` · ${formatFileSize(post.attachment.size)}`}
                    </div>
                </div>
                <div class="attachment-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 4v16m0 0l-6-6m6 6l6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </a>
        )}
        
    </article>
</MainLayout>

<style>
    .article-container { 
        width: 100%; 
        max-width: 760px; 
        margin: 0 auto; 
        padding: 0 20px 100px; 
    }
    
    .article-header { 
        margin-bottom: 50px; 
        text-align: center; 
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .category-tag { 
        display: inline-block; 
        color: var(--accent-primary); 
        font-size: 0.85rem; 
        font-weight: 600; 
        text-transform: uppercase; 
        letter-spacing: 2px; 
        margin-bottom: 20px; 
    }
    
    .article-main-title { 
        font-family: var(--font-head); 
        font-size: 3.5rem; 
        line-height: 1.15; 
        margin-bottom: 35px; 
        color: var(--text-main); 
        font-weight: 400;
    }
    
    .article-meta { 
        display: flex; 
        align-items: center; 
        gap: 15px; 
        font-family: var(--font-body);
        font-size: 1rem; 
        color: var(--text-muted); 
    }
    
    .meta-author { 
        display: flex; 
        align-items: center; 
        gap: 12px; 
        font-weight: 500; 
        color: var(--text-main); 
    }
    
    .author-avatar { 
        width: 40px; 
        height: 40px; 
        border-radius: 50%; 
        object-fit: cover; 
    }
    
    .author-avatar-placeholder { 
        width: 40px; 
        height: 40px; 
        border-radius: 50%; 
        background: #e0e0e0; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        font-size: 1.2rem; 
    }

    .meta-dot {
        font-size: 1.2rem;
        line-height: 0;
    }
    
    .article-hero-image { 
        width: 100%; 
        margin-bottom: 60px; 
        border-radius: 24px;
        overflow: hidden; 
        box-shadow: 0 10px 40px rgba(0,0,0,0.04); 
    }
    
    .article-hero-image img { 
        width: 100%; 
        height: auto; 
        display: block; 
    }

    /* === Карточка прикреплённого файла === */
    .attachment-card {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 60px;
        padding: 22px 26px;
        background: #fafafa;
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 18px;
        text-decoration: none;
        color: var(--text-main);
        position: relative;
        z-index: 1;
        transition: 
            transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.4s ease,
            background 0.4s ease;
    }

    .attachment-card:hover {
        transform: translateY(-3px);
        background: #ffffff;
        border-color: rgba(128, 37, 37, 0.2);
        box-shadow: 0 14px 40px rgba(0, 0, 0, 0.08);
    }

    .attachment-icon {
        flex-shrink: 0;
        width: 52px;
        height: 56px;
        position: relative;
        color: var(--accent-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .attachment-icon svg {
        width: 100%;
        height: 100%;
    }

    .attachment-ext {
        position: absolute;
        bottom: 8px;
        left: 50%;
        transform: translateX(-50%);
        font-family: var(--font-body);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #fff;
        background: var(--accent-primary);
        padding: 2px 6px;
        border-radius: 3px;
        line-height: 1;
    }

    .attachment-info {
        flex: 1;
        min-width: 0;
    }

    .attachment-label {
        font-family: var(--font-head);
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--text-main);
        margin-bottom: 4px;
        line-height: 1.3;
    }

    .attachment-meta {
        font-family: var(--font-body);
        font-size: 0.9rem;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .attachment-arrow {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(128, 37, 37, 0.08);
        color: var(--accent-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 
            background 0.4s ease,
            transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .attachment-arrow svg {
        width: 18px;
        height: 18px;
    }

    .attachment-card:hover .attachment-arrow {
        background: var(--accent-primary);
        color: #fff;
        transform: translateY(2px);
    }

    @media (max-width: 768px) {
        .article-main-title { font-size: 2.5rem; }
        .article-meta { flex-direction: column; gap: 8px; }
        .meta-dot { display: none; }
        .article-hero-image { border-radius: 16px; margin-bottom: 40px; }

        .attachment-card {
            gap: 14px;
            padding: 16px 18px;
            margin-top: 40px;
        }
        .attachment-icon {
            width: 42px;
            height: 46px;
        }
        .attachment-label {
            font-size: 1.05rem;
        }
        .attachment-meta {
            font-size: 0.8rem;
        }
        .attachment-arrow {
            width: 32px;
            height: 32px;
        }
    }
</style>

<style is:global>
    .editorial-content {
        font-family: var(--font-body);
        font-size: 1.15rem;
        line-height: 1.75;
        color: #333333;
        text-align: justify;
        position: relative;
    }

    .editorial-content::before {
        content: '';
        position: fixed;
        top: 50%;
        left: calc(50% + 130px);
        transform: translate(-50%, -50%) rotate(-20deg);
        width: 350px;
        height: 350px;
        background: url('/favicon.svg') center / contain no-repeat;
        opacity: 0.035;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }

    .editorial-content p { margin-bottom: 1.2em; }
    .editorial-content h2 { font-family: var(--font-head); font-size: 2.2rem; font-weight: 400; margin: 2em 0 0.8em; color: var(--text-main); line-height: 1.3; text-align: left; }
    .editorial-content h3 { font-family: var(--font-head); font-size: 1.6rem; font-weight: 400; margin: 1.8em 0 0.6em; color: var(--text-main); text-align: left; }
    .editorial-content strong { font-weight: 600; color: #111; }
    .editorial-content em { font-family: var(--font-head); font-style: italic; color: #444; }
    .editorial-content ul { margin-bottom: 1.5em; padding-left: 1.5em; list-style-type: none; }
    .editorial-content li { margin-bottom: 0.6em; position: relative; text-align: left; }
    .editorial-content ul li::before { content: "•"; color: var(--accent-primary); font-weight: bold; position: absolute; left: -1em; }
    .editorial-content blockquote { margin: 1.5em 0; padding: 0 0 0 1.5em; border-left: 3px solid var(--accent-primary); font-style: italic; font-family: var(--font-head); font-size: 1.4rem; color: #555; line-height: 1.6; text-align: left; }
    
    .editorial-content blockquote p:empty { display: none; }
    .editorial-content blockquote p:first-child { margin-top: 0; }
    .editorial-content blockquote p:last-child { margin-bottom: 0; }
    
    .editorial-content a { color: var(--accent-primary); text-decoration: none; border-bottom: 1px solid rgba(128, 37, 37, 0.3); transition: 0.2s; }
    .editorial-content a:hover { border-bottom-color: var(--accent-primary); background-color: rgba(128, 37, 37, 0.05); }

    .editorial-content img { border-radius: 16px; margin: 2em 0; width: 100%; height: auto; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }

    .editorial-content .drop-cap::first-letter {
        color: var(--accent-primary);
    }

    @media (max-width: 768px) {
        .editorial-content::before {
            left: 50%;
            width: 250px;
            height: 250px;
        }
    }
</style>

<script>
    function initDropCap() {
        const content = document.querySelector('.editorial-content');
        if (!content) return;
        const firstP = content.querySelector('p');
        if (firstP && firstP.textContent && firstP.textContent.trim().length > 0) {
            firstP.classList.add('drop-cap');
        }
    }

    initDropCap();
    document.addEventListener('astro:after-swap', initDropCap);
</script>

<script>
    function initTooltips() {
        const tooltips = document.querySelectorAll('.glossary-tooltip');
        
        tooltips.forEach(tip => {
            tip.addEventListener('click', (e) => {
                if (window.innerWidth > 768) return;
                e.preventDefault();
                
                tooltips.forEach(t => t.classList.remove('active'));
                tip.classList.toggle('active');
            });
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.glossary-tooltip')) {
                tooltips.forEach(t => t.classList.remove('active'));
            }
        });
    }

    initTooltips();
    document.addEventListener('astro:after-swap', initTooltips);
</script>